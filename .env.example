# Bot config (copy to .env and adjust)
PREFIX=.
BOT_NAME=RexBot
PACK_NAME=RexBot
PACK_PUBLISHER=RexBot Team
MAX_VIDEO_SECONDS=10
# Longest audio on a static sound sticker. Animated ones follow the clip.
SOUND_MAX_SECONDS=10
COOLDOWN_MS=3000
# How many media conversions run at the same time. Extra items queue and
# still convert; this only keeps sharp/ffmpeg from starving the event loop.
MEDIA_CONCURRENCY=4
FFMPEG_TIMEOUT_MS=30000

# Logging: debug, info, warn, error. Pretty in a terminal; LOG_PRETTY=false
# forces raw JSON even there.
# LOG_LEVEL=info
# LOG_PRETTY=true

# Message theme
# THEME_STYLE=divider  # divider (default) or minimal
# THEME_ACCENT=·
# THEME_DIVIDER=━
# THEME_DIVIDER_WIDTH=15