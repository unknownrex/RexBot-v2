# Bot config (copy to .env and adjust)
PREFIX=.
BOT_NAME=RexBot
PACK_NAME=RexBot
PACK_PUBLISHER=RexBot Team
MAX_VIDEO_SECONDS=6
COOLDOWN_MS=3000
# How many sticker/media commands may run per COOLDOWN_MS window.
# Lets a multi-image send convert in full instead of only the first.
MEDIA_BATCH_LIMIT=10
FFMPEG_TIMEOUT_MS=30000

# Message theme
# THEME_STYLE=divider  # divider (default) or minimal
# THEME_ACCENT=·
# THEME_DIVIDER=━
# THEME_DIVIDER_WIDTH=15